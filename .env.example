# better-vault needs no environment variables to run.
#
# API keys are entered in the app (Settings → AI providers) and stay in your
# browser. They are sent with each request to this app's own API routes, which
# pass them to the provider and never store or log them.

# Optional, for hosting better-vault for other people:
# Turn off Ollama and LM Studio (their address comes from the user).
# BETTER_VAULT_ALLOW_LOCAL_PROVIDERS=false
# Let web-page sources point at private or local network addresses.
# BETTER_VAULT_ALLOW_PRIVATE_URLS=true

# Optional: Google Drive and OneDrive in Settings → Storage. These identify
# your copy of better-vault to Google and Microsoft; they are public (they
# ship in the page) and read when you build. /docs/storage explains how to
# create them.
# VITE_GOOGLE_CLIENT_ID=            # OAuth client, type "Web application"
# VITE_GOOGLE_API_KEY=              # API key for the Google Picker
# VITE_GOOGLE_APP_ID=               # the Google Cloud project number
# VITE_GOOGLE_DESKTOP_CLIENT_ID=    # OAuth client, type "Desktop app" (desktop app)
# VITE_GOOGLE_DESKTOP_CLIENT_SECRET=
# VITE_MICROSOFT_CLIENT_ID=         # Microsoft Entra app (client) id
