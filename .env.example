# better-vault needs no environment variables to run.
#
# API keys are entered in the app (Settings → AI providers) and stay in your
# browser. They are sent with each request to this app's own API routes, which
# pass them to the provider and never store or log them.

# Optional, for hosting better-vault for other people:
# Turn off Ollama and LM Studio (their address comes from the user).
# BETTER_VAULT_ALLOW_LOCAL_PROVIDERS=false
# Let web-page sources point at private or local network addresses.
# BETTER_VAULT_ALLOW_PRIVATE_URLS=true
