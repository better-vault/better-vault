{
  "name": "better-vault",
  "version": "0.7.0",
  "description": "An open-source, bring-your-own-model alternative to NotebookLM.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/better-vault/better-vault.git"
  },
  "homepage": "https://better-vault.dev",
  "bugs": {
    "url": "https://github.com/better-vault/better-vault/issues"
  },
  "engines": {
    "node": ">=22.12",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr server/node.ts --outDir dist/server --emptyOutDir",
    "start": "node dist/server/node.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "node scripts/check-locales.mjs",
    "setup": "npm install && npm install --prefix site && npm install --prefix desktop",
    "site:dev": "npm run dev --prefix site",
    "site:build": "npm run build --prefix site",
    "site:check": "npm run lint --prefix site && npm run typecheck --prefix site && npm run build --prefix site",
    "desktop:dev": "npm run dev --prefix desktop",
    "desktop:start": "npm start --prefix desktop",
    "desktop:pack": "npm run pack --prefix desktop",
    "desktop:dist": "npm run dist --prefix desktop",
    "desktop:check": "npm run typecheck --prefix desktop && npm run desktop:pack"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.87",
    "@ai-sdk/deepseek": "^3.0.72",
    "@ai-sdk/elevenlabs": "^3.0.78",
    "@ai-sdk/google": "^4.0.104",
    "@ai-sdk/openai": "^4.0.101",
    "@ai-sdk/openai-compatible": "^3.0.77",
    "@ai-sdk/react": "^4.0.154",
    "@base-ui/react": "^1.9.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@mozilla/readability": "^0.6.0",
    "@types/mdast": "^4.0.4",
    "ai": "^7.0.150",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "d3-force": "^3.0.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "docx": "^9.14.0",
    "hono": "^4.13.16",
    "i18next": "^26.5.6",
    "linkedom": "^0.18.14",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "minisearch": "^7.2.0",
    "pele": "^1.9.0",
    "perfect-freehand": "^1.2.3",
    "pptxgenjs": "^4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.4",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "remark-gfm": "^4.0.1",
    "roughjs": "^4.6.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.9.1",
    "write-excel-file": "^4.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.14.0",
    "jszip": "^3.10.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "image-size": "^2.0.4"
  },
  "type": "module"
}
