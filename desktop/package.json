{
  "name": "better-vault-desktop",
  "productName": "better-vault",
  "private": true,
  "version": "0.0.0",
  "description": "The better-vault desktop app: Electron around the same Vite app.",
  "license": "MIT",
  "author": {
    "name": "better-vault contributors"
  },
  "homepage": "https://better-vault.dev",
  "main": "out/main/main.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dist": "npm run build && electron-builder --config electron-builder.config.mjs",
    "pack": "npm run build && electron-builder --config electron-builder.config.mjs --dir",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "electron-updater": "^6.8.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
