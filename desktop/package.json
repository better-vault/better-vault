{
  "name": "better-vault-desktop",
  "productName": "better-vault",
  "private": true,
  "version": "0.0.0",
  "description": "The better-vault desktop app: Electron around the same Next.js app.",
  "license": "MIT",
  "author": {
    "name": "better-vault contributors"
  },
  "homepage": "https://better-vault.dev",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build:server": "node scripts/build-server.mjs",
    "build": "node scripts/bundle.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev-url=http://localhost:3000",
    "dist": "npm run build && electron-builder --config electron-builder.config.mjs",
    "pack": "npm run build && electron-builder --config electron-builder.config.mjs --dir",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
